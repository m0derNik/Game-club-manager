<Page x:Class="GameClubManager.Client.Pages.ComputerRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameClubManager.Client.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Регистрация компьютера">

    <Grid>
        <materialDesign:Card Margin="20" Padding="20" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация компьютера" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Center"/>

                <TextBox x:Name="NameTextBox" 
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Название компьютера"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" />

                <TextBox x:Name="IpAddressTextBox" 
                         Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="IP адрес"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" />

                <TextBox x:Name="MacAddressTextBox" 
                         Text="{Binding MacAddress, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="MAC адрес"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" />

                <TextBox x:Name="SpecificationsTextBox" 
                         Text="{Binding Specifications, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Характеристики"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="100"
                         Margin="0,0,0,20" />

                <Button Content="Зарегистрировать компьютер" 
                        Command="{Binding RegisterComputerCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        materialDesign:ButtonAssist.CornerRadius="10"
                        Height="50"
                        Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ProgressBar IsIndeterminate="True" 
                             Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}" 
                             Height="4"
                             Margin="0,10,0,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page> 