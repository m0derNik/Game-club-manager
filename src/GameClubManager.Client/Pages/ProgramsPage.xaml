<Page x:Class="GameClubManager.Client.Pages.ProgramsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Программы">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и поиск -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Доступные игры"
                      Style="{StaticResource HeaderTextStyle}"
                      VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Command="{Binding RefreshGamesCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    ToolTip="Обновить список игр"
                    Width="36" Height="36"
                    Margin="8,0"
                    Background="{DynamicResource PrimaryBrush}">
                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
            </Button>

            <TextBox Grid.Column="2"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Поиск игр..."
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.PrefixText="🔍"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     CaretBrush="{DynamicResource TextPrimaryBrush}"/>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                         Width="50" Height="50" 
                         IsIndeterminate="True"
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"/>
            <TextBlock Text="Загрузка игр..." 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="0,75,0,0"/>
        </Grid>

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding ErrorMessage}" 
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="400"/>

        <!-- Список игр -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,16,0"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Style="{StaticResource ModernCard}"
                                           Width="280"
                                           Height="380"
                                           Margin="12,12,20,20"
                                           materialDesign:ElevationAssist.Elevation="Dp4"
                                           UniformCornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Изображение игры -->
                                <Border Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="8"
                                        Margin="0,0,0,16">
                                    <Image Source="{Binding IconSource}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Stretch="Uniform"
                                           Margin="32"/>
                                </Border>

                                <!-- Название игры -->
                                <StackPanel Grid.Row="1"
                                          Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Name}"
                                             Style="{StaticResource SubheaderTextStyle}"
                                             TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Margin="8,0"/>
                                    <TextBlock Text="{Binding Description}"
                                             Style="{StaticResource BodyTextStyle}"
                                             TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             Margin="12,8,12,0"
                                             FontSize="14"/>
                                </StackPanel>

                                <!-- Кнопка запуска -->
                                <Button Grid.Row="2"
                                        Style="{StaticResource ModernButton}"
                                        Command="{Binding DataContext.LaunchGameCommand, 
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Height="52"
                                        Margin="16,0,16,16"
                                        materialDesign:ButtonAssist.CornerRadius="26"
                                        Background="{DynamicResource PrimaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Play"
                                                               Width="24"
                                                               Height="24"
                                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="ЗАПУСТИТЬ"
                                                 FontWeight="Medium"
                                                 FontSize="16"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page> 