<Page x:Class="GameClubManager.Client.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Настройки">

    <Grid Margin="24">
        <materialDesign:Card Style="{StaticResource ModernCard}"
                             Width="600"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Text="Настройки"
                           Style="{StaticResource HeaderTextStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Кнопка настроек мыши -->
                <Button Grid.Row="1"
                        Style="{StaticResource ModernButton}"
                        Height="52"
                        Margin="0,0,0,16"
                        materialDesign:ButtonAssist.CornerRadius="26"
                        Background="{DynamicResource PrimaryBrush}"
                        Click="OpenMouseSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Mouse" 
                                               Width="24" 
                                               Height="24"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>
                        <TextBlock Text="НАСТРОЙКИ МЫШИ"
                                   FontWeight="Medium"
                                   FontSize="16"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page> 