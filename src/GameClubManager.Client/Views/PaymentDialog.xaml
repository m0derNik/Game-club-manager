<Window x:Class="GameClubManager.Client.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d" 
        Height="500" Width="450"
        Title="Пополнение баланса"
        TextElement.Foreground="{DynamicResource MaterialDesignLightForeground}">

    <materialDesign:Card Background="{DynamicResource PrimaryDarkBrush}"
                         UniformCornerRadius="8"
                         Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" 
                  Background="{DynamicResource PrimaryBrush}"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Пополнение баланса" 
                           Margin="16"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="32" Width="32"
                        Padding="4"
                        Foreground="White"
                        Click="CloseButton_Click">
                    <materialDesign:PackIcon Kind="Close"/>
                </Button>
            </Grid>

            <!-- Основной контент -->
            <StackPanel Grid.Row="1" Margin="24,16">
                <!-- Сумма пополнения -->
                <TextBlock Text="Сумма пополнения"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,16,0,8"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="AmountTextBox"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Введите сумму"
                             materialDesign:HintAssist.Foreground="LightGray"
                             Foreground="White"
                             Background="#44FFFFFF"
                             BorderBrush="White"
                             CaretBrush="White"
                             PreviewTextInput="NumberValidationTextBox"/>
                    
                    <TextBlock Grid.Column="1"
                               Text="₽"
                               FontSize="18"
                               Foreground="White"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Способы оплаты -->
                <TextBlock Text="Способ оплаты"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,24,0,8"/>
                
                <materialDesign:Card Margin="0,0,0,8" UniformCornerRadius="4" Background="#44FFFFFF">
                    <RadioButton x:Name="CreditCardRadio"
                                 Content="Банковская карта"
                                 Margin="16,12"
                                 Foreground="White"
                                 IsChecked="True"
                                 GroupName="PaymentMethod"/>
                </materialDesign:Card>
                
                <materialDesign:Card Margin="0,0,0,8" UniformCornerRadius="4" Background="#44FFFFFF">
                    <RadioButton x:Name="QiwiRadio"
                                 Content="QIWI Кошелек"
                                 Foreground="White"
                                 Margin="16,12"
                                 GroupName="PaymentMethod"/>
                </materialDesign:Card>
                
                <materialDesign:Card Margin="0,0,0,8" UniformCornerRadius="4" Background="#44FFFFFF">
                    <RadioButton x:Name="YandexRadio"
                                 Content="Яндекс Деньги"
                                 Foreground="White"
                                 Margin="16,12"
                                 GroupName="PaymentMethod"/>
                </materialDesign:Card>

                <!-- Данные карты (появляются только при выборе карты) -->
                <StackPanel x:Name="CardDetailsPanel" Visibility="{Binding IsChecked, ElementName=CreditCardRadio, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Данные карты"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,16,0,8"/>
                    
                    <TextBox x:Name="CardNumberTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Номер карты"
                             materialDesign:HintAssist.Foreground="LightGray"
                             Background="#44FFFFFF"
                             BorderBrush="White"
                             Foreground="White"
                             CaretBrush="White"
                             Margin="0,0,0,8"
                             MaxLength="19"
                             PreviewTextInput="NumberValidationTextBox"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBox x:Name="CardExpiryTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="MM/ГГ"
                                 materialDesign:HintAssist.Foreground="LightGray"
                                 Background="#44FFFFFF"
                                 BorderBrush="White"
                                 Foreground="White"
                                 CaretBrush="White"
                                 Margin="0,0,4,0"
                                 MaxLength="5"/>
                        
                        <TextBox Grid.Column="1"
                                 x:Name="CardCVVTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="CVV"
                                 materialDesign:HintAssist.Foreground="LightGray"
                                 Background="#44FFFFFF"
                                 BorderBrush="White"
                                 Foreground="White"
                                 CaretBrush="White"
                                 Margin="4,0,0,0"
                                 MaxLength="3"
                                 PreviewTextInput="NumberValidationTextBox"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Margin="0,0,24,16">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Отмена"
                        Foreground="White"
                        BorderBrush="White"
                        Margin="8,0"
                        Click="CancelButton_Click"/>
                
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Content="Пополнить"
                        Foreground="White"
                        Background="{DynamicResource SecondaryBrush}"
                        Click="PayButton_Click"/>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window> 