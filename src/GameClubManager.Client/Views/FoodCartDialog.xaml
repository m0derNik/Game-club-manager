<Window x:Class="GameClubManager.Client.Views.FoodCartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d" 
        Height="550" Width="500"
        Title="Корзина покупок"
        TextElement.Foreground="White">

    <materialDesign:Card Background="{DynamicResource PrimaryDarkBrush}"
                         UniformCornerRadius="8"
                         Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" 
                  Background="{DynamicResource PrimaryBrush}"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Корзина покупок" 
                           Margin="16"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                
                <Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="32" Width="32"
                        Padding="4"
                        Foreground="White"
                        Command="{Binding CloseCommand}">
                    <materialDesign:PackIcon Kind="Close"/>
                </Button>
            </Grid>

            <!-- Основной контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="Ваш заказ:"
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             Foreground="White"
                             Margin="0,8,0,16"/>
                    
                    <!-- Пустая корзина -->
                    <TextBlock Text="Корзина пуста. Добавьте товары."
                             Foreground="White"
                             TextAlignment="Center"
                             Margin="0,32,0,0"
                             Visibility="{Binding HasItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    
                    <!-- Список товаров в корзине -->
                    <ItemsControl ItemsSource="{Binding CartItems}"
                                Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card Margin="0,4,0,8" 
                                                   Background="#44FFFFFF" 
                                                   UniformCornerRadius="4">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel>
                                            <TextBlock Text="{Binding FoodItem.Name}" 
                                                     Foreground="White"
                                                     FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FoodItem.Price, StringFormat='{}{0:C}'}" 
                                                     Foreground="White"/>
                                        </StackPanel>
                                        
                                        <!-- Управление количеством -->
                                        <StackPanel Grid.Column="1" 
                                                  Orientation="Horizontal" 
                                                  VerticalAlignment="Center"
                                                  Margin="8,0">
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, 
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Minus" 
                                                                       Width="16" 
                                                                       Height="16"/>
                                            </Button>
                                            
                                            <TextBlock Text="{Binding Quantity}" 
                                                     Foreground="White"
                                                     Margin="8,0" 
                                                     VerticalAlignment="Center"/>
                                            
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="24" Height="24"
                                                    Padding="0"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, 
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Plus" 
                                                                       Width="16" 
                                                                       Height="16"/>
                                            </Button>
                                        </StackPanel>
                                        
                                        <!-- Сумма и удаление -->
                                        <StackPanel Grid.Column="2"
                                                  VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:C}'}" 
                                                     Foreground="White"
                                                     FontWeight="SemiBold"
                                                     HorizontalAlignment="Right"/>
                                            
                                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                    Height="24"
                                                    Padding="4,0"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.RemoveFromCartCommand, 
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding FoodItem.Id}">
                                                <TextBlock Text="Удалить" 
                                                         Foreground="Red" 
                                                         FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Итоговая информация и кнопки -->
            <StackPanel Grid.Row="2" 
                        Margin="16">
                <!-- Итоговая сумма -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Итого к оплате:" 
                             FontSize="18"
                             Foreground="White"
                             FontWeight="SemiBold"/>
                    
                    <TextBlock Grid.Column="1"
                             Text="{Binding CartTotal, StringFormat='{}{0:C}'}"
                             FontSize="18"
                             Foreground="White"
                             FontWeight="SemiBold"/>
                </Grid>
                
                <!-- Информация о балансе -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Ваш баланс:" 
                             Foreground="White"/>
                    
                    <TextBlock Grid.Column="1"
                             Text="{Binding Balance, StringFormat='{}{0:C}'}"
                             Foreground="White"/>
                </Grid>
                
                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" 
                          HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="Отмена"
                            Foreground="White"
                            BorderBrush="White"
                            Margin="8,0"
                            Command="{Binding CloseCommand}"/>
                    
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Оформить заказ"
                            Background="{DynamicResource SecondaryBrush}"
                            Command="{Binding PurchaseCommand}"
                            IsEnabled="{Binding HasItems}">
                        
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="Оформить заказ" 
                                             Visibility="{Binding DataContext.IsProcessing, 
                                                       RelativeSource={RelativeSource AncestorType=Button}, 
                                                       Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    
                                    <StackPanel Orientation="Horizontal"
                                              Visibility="{Binding DataContext.IsProcessing, 
                                                        RelativeSource={RelativeSource AncestorType=Button}, 
                                                        Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="Loading" 
                                                               Width="16" 
                                                               Height="16"
                                                               Margin="0,0,8,0">
                                            <materialDesign:PackIcon.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </materialDesign:PackIcon.RenderTransform>
                                            <materialDesign:PackIcon.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation 
                                                                Storyboard.TargetProperty="(FrameworkElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:1" 
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </materialDesign:PackIcon.Triggers>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="Обработка..."/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</Window> 