<Page x:Class="GameClubManager.Admin.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameClubManager.Admin.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="UsersPage">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и поиск -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Пользователи" 
                       Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal">
                <TextBox Width="300"
                         materialDesign:HintAssist.Hint="Поиск пользователя..."
                         materialDesign:HintAssist.Foreground="LightGray"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="Gray"
                         Margin="0,0,16,0"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,16,0"
                        ToolTip="Обновить">
                    <materialDesign:PackIcon Kind="Refresh" 
                                           Width="20" 
                                           Height="20"/>
                </Button>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{Binding AddUserCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" 
                                               Width="20" 
                                               Height="20" 
                                               Margin="0,0,8,0"/>
                        <TextBlock Text="Добавить пользователя"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Индикатор загрузки -->
        <materialDesign:Card Grid.Row="1" 
                           UniformCornerRadius="8"
                           Padding="24"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" 
                      VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                           Style="{StaticResource MaterialDesignCircularProgressBar}"
                           Width="50" 
                           Height="50"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Загрузка данных..." 
                         Style="{StaticResource MaterialDesignBody1TextBlock}"/>
            </StackPanel>
        </materialDesign:Card>
        
        <!-- Сообщение об отсутствии данных -->
        <materialDesign:Card Grid.Row="1" 
                            UniformCornerRadius="8"
                            Padding="24"
                            Visibility="{Binding IsEmptyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" 
                      VerticalAlignment="Center" 
                      Margin="16">
                <materialDesign:PackIcon Kind="AccountSearch" 
                                       Width="32" 
                                       Height="32" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                <TextBlock Text="Пользователи не найдены" 
                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                <TextBlock Text="Попробуйте изменить параметры поиска или обновить список" 
                         Style="{StaticResource MaterialDesignBody1TextBlock}"
                         TextAlignment="Center"
                         Margin="0,8,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Список пользователей -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                  Visibility="{Binding IsDataVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                  Binding="{Binding Id}" 
                                  Width="60"/>
                <DataGridTextColumn Header="Имя" 
                                  Binding="{Binding Name}" 
                                  Width="140"/>
                <DataGridTextColumn Header="Логин" 
                                  Binding="{Binding Username}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Email" 
                                  Binding="{Binding Email}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Баланс" 
                                  Binding="{Binding Balance, StringFormat='{}{0:C}'}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Оставшееся время" 
                                  Binding="{Binding FormattedRemainingTime}" 
                                  Width="120"/>
                <DataGridTextColumn Header="Роль" 
                                  Binding="{Binding Role}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Статус" 
                                  Binding="{Binding Status}" 
                                  Width="100"/>
                <DataGridTemplateColumn Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.AddBalanceCommand, 
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Пополнить баланс">
                                    <materialDesign:PackIcon Kind="Cash" 
                                                           Width="20" 
                                                           Height="20"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.AddTimeCommand, 
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Добавить время">
                                    <materialDesign:PackIcon Kind="Clock" 
                                                           Width="20" 
                                                           Height="20"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.EditUserCommand, 
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Редактировать">
                                    <materialDesign:PackIcon Kind="Pencil" 
                                                           Width="20" 
                                                           Height="20"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.DeleteUserCommand, 
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Удалить">
                                    <materialDesign:PackIcon Kind="Delete" 
                                                           Width="20" 
                                                           Height="20"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page> 