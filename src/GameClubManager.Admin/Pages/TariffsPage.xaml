<Page x:Class="GameClubManager.Admin.Pages.TariffsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameClubManager.Admin.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Тарифы">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки управления -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Тарифы" 
                       Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddTariffCommand}"
                    ToolTip="Добавить новый тариф">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Add" 
                                           Width="20" 
                                           Height="20"
                                           Margin="0,0,8,0"/>
                    <TextBlock Text="Добавить тариф"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1">
            <!-- Таблица тарифов (видима, когда не в режиме редактирования) -->
            <DataGrid ItemsSource="{Binding Tariffs}"
                      SelectedItem="{Binding SelectedTariff}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                      Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                      Binding="{Binding Id}" 
                                      Width="50"/>
                    
                    <DataGridTextColumn Header="Название" 
                                      Binding="{Binding Name}" 
                                      Width="180"/>
                    
                    <DataGridTextColumn Header="Описание" 
                                      Binding="{Binding Description}" 
                                      Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="WordEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Цена" 
                                      Binding="{Binding Price, StringFormat={}{0:C}}" 
                                      Width="120"/>
                    
                    <DataGridTemplateColumn Header="Продолжительность" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} ч {1} мин">
                                            <Binding Path="Duration.Hours"/>
                                            <Binding Path="Duration.Minutes"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Популярный" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsPopular, Mode=OneWay}" 
                                          IsEnabled="False" 
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Действия" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.EditTariffCommand, 
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Редактировать">
                                        <materialDesign:PackIcon Kind="Edit" 
                                                              Width="20" 
                                                              Height="20"/>
                                    </Button>
                                    
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.DeleteTariffCommand, 
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Удалить">
                                        <materialDesign:PackIcon Kind="Delete" 
                                                              Width="20" 
                                                              Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Форма редактирования тарифа (видима только в режиме редактирования) -->
            <materialDesign:Card Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                               UniformCornerRadius="8" 
                               Background="{DynamicResource SurfaceBrush}"
                               Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Заголовок формы -->
                    <TextBlock Grid.Row="0" 
                             Text="{Binding IsAdding, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Добавление тарифа;Редактирование тарифа'}" 
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="0,0,0,24"/>
                    
                    <!-- Поля формы -->
                    <StackPanel Grid.Row="1">
                        <TextBox materialDesign:HintAssist.Hint="Название тарифа"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding EditTariff.Name, UpdateSourceTrigger=PropertyChanged}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               CaretBrush="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>
                               
                        <TextBox materialDesign:HintAssist.Hint="Описание"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding EditTariff.Description, UpdateSourceTrigger=PropertyChanged}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               MinHeight="80"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               CaretBrush="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>
                               
                        <TextBox materialDesign:HintAssist.Hint="Цена (руб.)"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"
                               Text="{Binding EditTariff.Price, UpdateSourceTrigger=PropertyChanged}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               CaretBrush="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>
                               
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                   materialDesign:HintAssist.Hint="Часы"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding EditTariff.Hours, UpdateSourceTrigger=PropertyChanged}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,8,0"/>
                                   
                            <TextBox Grid.Column="1"
                                   materialDesign:HintAssist.Hint="Минуты"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding EditTariff.Minutes, UpdateSourceTrigger=PropertyChanged}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                                   Margin="8,0,0,0"/>
                        </Grid>
                        
                        <CheckBox Content="Пометить как популярный"
                                IsChecked="{Binding EditTariff.IsPopular}"
                                Style="{StaticResource MaterialDesignCheckBox}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                Margin="0,0,0,16"/>
                    </StackPanel>
                    
                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Command="{Binding CancelEditCommand}"
                              Content="Отмена"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,16,0"/>
                              
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Command="{Binding SaveTariffCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" 
                                                       Width="20" 
                                                       Height="20"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Сохранить"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
            
            <!-- Индикатор сохранения -->
            <Grid Background="#80000000" 
                Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" 
                               Style="{StaticResource MaterialDesignCircularProgressBar}"
                               Width="48" 
                               Height="48"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Сохранение..." 
                             Style="{StaticResource MaterialDesignBody1TextBlock}"
                             Foreground="White"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page> 