<Page x:Class="GameClubManager.Admin.Pages.FoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GameClubManager.Admin.Pages"
      xmlns:viewmodels="clr-namespace:GameClubManager.Admin.ViewModels"
      xmlns:models="clr-namespace:GameClubManager.Shared.Models"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:GameClubManager.Admin.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Управление меню">

    <Page.Resources>
        <viewmodels:FoodViewModel x:Key="ViewModel"/>
        <converters:BooleanToStringConverter x:Key="BoolToStringConverter" 
                                            TrueValue="Да" 
                                            FalseValue="Нет"/>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
        <converters:ObjectVisibilityConverter x:Key="ObjectVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid DataContext="{StaticResource ViewModel}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки управления -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Меню" 
                       Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding AddCommand}"
                    ToolTip="Добавить новый продукт">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Add" 
                                           Width="20" 
                                           Height="20"
                                           Margin="0,0,8,0"/>
                    <TextBlock Text="Добавить продукт"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1">
            <!-- Таблица продуктов (видима, когда не в режиме редактирования) -->
            <DataGrid ItemsSource="{Binding FoodItems}"
                      SelectedItem="{Binding SelectedFoodItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                      materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                      Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" 
                                      Binding="{Binding Id}" 
                                      Width="50"/>
                    
                    <DataGridTextColumn Header="Название" 
                                      Binding="{Binding Name}" 
                                      Width="180"/>
                    
                    <DataGridTextColumn Header="Описание" 
                                      Binding="{Binding Description}" 
                                      Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="WordEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Цена" 
                                      Binding="{Binding Price, StringFormat={}{0:C}}" 
                                      Width="120"/>
                    
                    <DataGridTextColumn Header="Категория" 
                                      Binding="{Binding Category}" 
                                      Width="120"/>
                    
                    <DataGridTemplateColumn Header="Доступен" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAvailable, Mode=OneWay}" 
                                          IsEnabled="False" 
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTemplateColumn Header="Действия" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.EditCommand, 
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Редактировать">
                                        <materialDesign:PackIcon Kind="Edit" 
                                                              Width="20" 
                                                              Height="20"/>
                                    </Button>
                                    
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.DeleteCommand, 
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Удалить">
                                        <materialDesign:PackIcon Kind="Delete" 
                                                              Width="20" 
                                                              Height="20"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Форма редактирования продукта (видима только в режиме редактирования) -->
            <materialDesign:Card Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                               UniformCornerRadius="8" 
                               Background="{DynamicResource SurfaceBrush}"
                               Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Заголовок формы -->
                    <TextBlock Grid.Row="0" 
                             Text="{Binding IsEditing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Добавление продукта;Редактирование продукта'}" 
                             Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="0,0,0,24"/>
                    
                    <!-- Поля формы -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="Название продукта"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding EditingFoodItem.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                                   
                            <TextBox materialDesign:HintAssist.Hint="Описание"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding EditingFoodItem.Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   TextWrapping="Wrap"
                                   AcceptsReturn="True"
                                   MinHeight="80"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                                   
                            <TextBox materialDesign:HintAssist.Hint="Цена (руб.)"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding EditingFoodItem.Price, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                                   
                            <TextBox materialDesign:HintAssist.Hint="URL изображения"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   Text="{Binding EditingFoodItem.ImageUrl, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   CaretBrush="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>
                            
                            <ComboBox materialDesign:HintAssist.Hint="Категория"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    ItemsSource="{Binding FoodCategories}" 
                                    SelectedItem="{Binding EditingFoodItem.Category}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,0,16"/>
                            
                            <CheckBox Content="Доступен для заказа"
                                    IsChecked="{Binding EditingFoodItem.IsAvailable}"
                                    Style="{StaticResource MaterialDesignCheckBox}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,0,16"/>
                            
                            <Image Source="{Binding EditingFoodItem.ImageUrl}" 
                                 MaxHeight="150" 
                                 Stretch="Uniform"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding EditingFoodItem.ImageUrl, Converter={StaticResource StringVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2" 
                              Orientation="Horizontal" 
                              HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                              Command="{Binding CancelCommand}"
                              Content="Отмена"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,16,0"/>
                              
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" 
                                                       Width="20" 
                                                       Height="20"
                                                       Margin="0,0,8,0"/>
                                <TextBlock Text="Сохранить"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
            
            <!-- Индикатор загрузки -->
            <Grid Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" 
                               Style="{StaticResource MaterialDesignCircularProgressBar}"
                               Width="48" 
                               Height="48"
                               Margin="0,0,0,16"/>
                    <TextBlock Text="Загрузка..." 
                             Style="{StaticResource MaterialDesignBody1TextBlock}"
                             Foreground="White"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            
            <!-- Сообщение об ошибке -->
            <materialDesign:Snackbar Visibility="{Binding ErrorMessage, Converter={StaticResource StringVisibilityConverter}}"
                                   MessageQueue="{materialDesign:MessageQueue}"
                                   Message="{Binding ErrorMessage}"/>
        </Grid>
    </Grid>
</Page> 